<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.db_project.controller.ProductController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <top>
        <VBox spacing="10">
            <Label text="Product Management" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox spacing="8">
                <TextField fx:id="searchField" promptText="Search products by name"
                           prefWidth="280" onAction="#handleSearch"/>
                <ComboBox fx:id="filterCategoryCombo" prefWidth="180"/>
                <Button text="Search" onAction="#handleSearch" defaultButton="true"/>
                <Button text="Reset" onAction="#handleResetSearch"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="8">
            <BorderPane.margin>
                <Insets top="10" bottom="10"/>
            </BorderPane.margin>
            <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="220"/>
                    <TableColumn fx:id="categoryColumn" text="Category" prefWidth="140"/>
                    <TableColumn fx:id="priceColumn" text="Price" prefWidth="90"/>
                    <TableColumn fx:id="stockColumn" text="Stock" prefWidth="70"/>
                </columns>
            </TableView>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="prevButton" text="‹ Previous" onAction="#handlePrevPage"/>
                <Label fx:id="pageLabel"/>
                <Button fx:id="nextButton" text="Next ›" onAction="#handleNextPage"/>
            </HBox>
        </VBox>
    </center>

    <right>
        <VBox spacing="8" prefWidth="270">
            <BorderPane.margin>
                <Insets left="15" top="10"/>
            </BorderPane.margin>
            <Label text="Name *"/>
            <TextField fx:id="nameField"/>
            <Label text="Category *"/>
            <ComboBox fx:id="categoryCombo" maxWidth="Infinity" promptText="Choose a category"/>
            <Label text="Price *"/>
            <TextField fx:id="priceField" promptText="e.g. 19.99"/>
            <Label text="Stock quantity *"/>
            <TextField fx:id="stockField" promptText="e.g. 25"/>
            <Label text="Description"/>
            <TextArea fx:id="descriptionField" prefRowCount="3" wrapText="true"/>
            <HBox spacing="8">
                <Button text="Add" onAction="#handleAdd"/>
                <Button text="Update" onAction="#handleUpdate"/>
                <Button text="Delete" onAction="#handleDelete"/>
                <Button text="Clear" onAction="#handleClear"/>
            </HBox>
        </VBox>
    </right>

    <bottom>
        <Label fx:id="statusLabel"/>
    </bottom>
</BorderPane>
