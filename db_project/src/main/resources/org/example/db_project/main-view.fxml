<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>

<TabPane xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.example.db_project.controller.MainController"
         fx:id="tabPane"
         tabClosingPolicy="UNAVAILABLE"
         prefWidth="1250" prefHeight="720">
    <tabs>
        <Tab text="Categories">
            <content>
                <fx:include source="category-view.fxml"/>
            </content>
        </Tab>
        <Tab fx:id="productsTab" text="Products">
            <content>
                <fx:include fx:id="productView" source="product-view.fxml"/>
            </content>
        </Tab>
        <Tab fx:id="ordersTab" text="Orders">
            <content>
                <fx:include fx:id="orderView" source="order-view.fxml"/>
            </content>
        </Tab>
    </tabs>
</TabPane>
